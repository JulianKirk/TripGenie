# TripGenie Environment Configuration Placeholder
OLLAMA_HOST=http://127.0.0.1:11434
AI_MODEL=qwen2.5:0.5b

# Shared Release 0 AI-Mode service settings
AI_MODE_OLLAMA_BASE_URL=http://127.0.0.1:11434
# docker-compose.yml overrides this with http://host.docker.internal:11434.
AI_MODE_DEFAULT_MODEL=qwen2.5:0.5b
AI_MODE_ALLOWED_MODELS=qwen2.5:0.5b,llama3.1:8b
AI_MODE_TIMEOUT_SECONDS=15
AI_MODE_MAX_PROMPT_CHARS=12000
AI_MODE_MAX_SCHEMA_CHARS=8000
AI_MODE_MAX_RESPONSE_BYTES=16384

# Student backend consumer pattern for the shared AI-Mode service
STUDENT1_BACKEND_AI_MODE_BASE_URL=
# Compose-only value:
# STUDENT1_BACKEND_AI_MODE_BASE_URL=http://ai-mode:8006
STUDENT1_BACKEND_AI_MODE_TIMEOUT_SECONDS=15
STUDENT1_BACKEND_AI_MODE_MAX_PROMPT_CHARS=12000
# Recommended future consumer pattern:
# STUDENT2_BACKEND_AI_MODE_BASE_URL=http://ai-mode:8006  # Compose-only
# STUDENT2_BACKEND_AI_MODE_TIMEOUT_SECONDS=15
# STUDENT3_BACKEND_AI_MODE_BASE_URL=http://ai-mode:8006  # Compose-only
# STUDENT3_BACKEND_AI_MODE_TIMEOUT_SECONDS=15
# STUDENT4_BACKEND_AI_MODE_BASE_URL=http://ai-mode:8006  # Compose-only
# STUDENT4_BACKEND_AI_MODE_TIMEOUT_SECONDS=15
# STUDENT5_BACKEND_AI_MODE_BASE_URL=http://ai-mode:8006  # Compose-only
# STUDENT5_BACKEND_AI_MODE_TIMEOUT_SECONDS=15

# Per-service DB connection (each microservice sets its own; this is student-2's default)
# Path is relative to the repo root (nothing loads this file automatically -- export it yourself)
DATABASE_URL=sqlite:///student-2/database/accommodation.db

# The shared reference service (country + city). Every service that stores a
# place points at this one; see shared/shared-service.md.
LOCATION_URL=http://shared-backend:9100

# --- Student 3: Transport Management -----------------------------------------
# Defaults match docker-compose.yml; override only what you need. The frontend
# host port is 8093 rather than 8083 because a development machine has another
# service holding 8083.
STUDENT3_FRONTEND_HOST_PORT=8093
STUDENT3_FRONTEND_BACKEND_BASE_URL=http://student-3-backend:8003
STUDENT3_FRONTEND_BACKEND_API_PREFIX=/api
STUDENT3_FRONTEND_BACKEND_TIMEOUT_SECONDS=5

STUDENT3_BACKEND_API_PREFIX=/api
STUDENT3_BACKEND_DB_API_BASE_URL=http://student-3-database:8004
STUDENT3_BACKEND_DB_API_PREFIX=/internal
STUDENT3_BACKEND_DB_API_TIMEOUT_SECONDS=5
# Trip picker and the optional existence check both read Student 1's API.
STUDENT3_BACKEND_TRIPS_API_BASE_URL=http://student-1-backend:8001
STUDENT3_BACKEND_TRIPS_API_PREFIX=/api
STUDENT3_BACKEND_TRIPS_API_TIMEOUT_SECONDS=5
# Off by default: a plan entry is still useful when Student 1 is unreachable.
STUDENT3_BACKEND_VERIFY_TRIP_EXISTS=false

STUDENT3_SQLITE_PATH=/data/student-3/tripgenie.db
STUDENT3_SEED_DATA=true

# TripGenie Environment Configuration Placeholder
OLLAMA_HOST=http://localhost:11434
AI_MODEL=qwen2.5:0.5b

# Per-service DB connection (each microservice sets its own; this is student-2's default)
# Path is relative to the repo root (nothing loads this file automatically -- export it yourself)
DATABASE_URL=sqlite:///student-2/database/accommodation.db

# Shared user service. Note DATABASE_URL means two different things depending on
# which container reads it -- a SQLite path in the database service, the address
# of that service in the backend -- so do not hand this whole file to both.
# shared-user-database:
#   DATABASE_URL=sqlite:///shared/user/database/user.db
#   SEED_DATA=1
# shared-user-backend:
#   DATABASE_URL=http://shared-user-database:9101
#   DB_TIMEOUT=5
# shared-user-frontend:
#   BACKEND_URL=http://shared-user-backend:9100
#   BACKEND_TIMEOUT=5

# TripGenie Environment Configuration Placeholder
OLLAMA_HOST=http://localhost:11434
AI_MODEL=qwen2.5:0.5b

# Shared Release 0 AI-Mode service settings (documented here; final Compose wiring is issue #13)
AI_MODE_OLLAMA_BASE_URL=http://ollama:11434
AI_MODE_DEFAULT_MODEL=qwen2.5:0.5b
AI_MODE_ALLOWED_MODELS=qwen2.5:0.5b,llama3.1:8b
AI_MODE_TIMEOUT_SECONDS=15
AI_MODE_MAX_PROMPT_CHARS=12000
AI_MODE_MAX_SCHEMA_CHARS=8000
AI_MODE_MAX_RESPONSE_BYTES=16384

# Student backend consumer pattern for the shared AI-Mode service
STUDENT1_BACKEND_AI_MODE_BASE_URL=http://ai-mode:8006
STUDENT1_BACKEND_AI_MODE_TIMEOUT_SECONDS=15
# Recommended future consumer pattern:
# STUDENT2_BACKEND_AI_MODE_BASE_URL=http://ai-mode:8006
# STUDENT2_BACKEND_AI_MODE_TIMEOUT_SECONDS=15
# STUDENT3_BACKEND_AI_MODE_BASE_URL=http://ai-mode:8006
# STUDENT3_BACKEND_AI_MODE_TIMEOUT_SECONDS=15
# STUDENT4_BACKEND_AI_MODE_BASE_URL=http://ai-mode:8006
# STUDENT4_BACKEND_AI_MODE_TIMEOUT_SECONDS=15
# STUDENT5_BACKEND_AI_MODE_BASE_URL=http://ai-mode:8006
# STUDENT5_BACKEND_AI_MODE_TIMEOUT_SECONDS=15

# Per-service DB connection (each microservice sets its own; this is student-2's default)
# Path is relative to the repo root (nothing loads this file automatically -- export it yourself)
DATABASE_URL=sqlite:///student-2/database/accommodation.db

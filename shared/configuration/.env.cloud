# TripGenie cloud profile: every AI feature off, and frontends trust the
# Azure ingress's X-Forwarded-Proto (last entry below).
# AI-Mode, RAG, MCP and Ollama are host processes (see .env.example) and are not
# deployed to the cloud, so host.docker.internal resolves to nothing there.
# Each switch below turns its panel into a "disabled" message instead of a
# failed call; CRUD and readiness never depend on any of them.
#   docker compose --env-file shared/configuration/.env.cloud up --build -d
# The Azure Bicep parameters read the same values.

# Student 1: grounded trip guide (RAG) -- no RAG server in the cloud.
STUDENT1_BACKEND_RAG_ENABLED=false
# Student 1: MCP trip assistant -- it runs through AI-Mode, which is not deployed.
STUDENT1_BACKEND_MCP_ENABLED=false

# Student 2: ask box and MCP assistant -- blank means "not_configured" (no AI-Mode).
STUDENT2_BACKEND_AI_MODE_URL=
# Student 2: guide box (RAG) -- blank turns it off; no RAG server in the cloud.
STUDENT2_BACKEND_RAG_URL=

# Student 3: MCP transport lookups -- no MCP server in the cloud.
STUDENT3_BACKEND_MCP_ENABLED=false
# Student 3: transport guide (RAG) -- no RAG server in the cloud.
STUDENT3_BACKEND_RAG_ENABLED=false
# Student 3: multi-agent planning -- no Multi-Agent Server in the cloud.
STUDENT3_BACKEND_MULTI_AGENT_ENABLED=false

# Student 4: MCP activity assistant -- it runs through AI-Mode, which is not deployed.
STUDENT4_AI_ASSISTANT_ENABLED=false
# Student 4: activity knowledge guide (RAG) -- no RAG server in the cloud.
STUDENT4_BACKEND_RAG_ENABLED=false

# Student 5: budget guide (RAG) -- no RAG server in the cloud.
STUDENT5_BACKEND_RAG_ENABLED=false
# Student 5: MCP budget assistant -- it runs through AI-Mode, which is not deployed.
STUDENT5_BACKEND_MCP_ENABLED=false

# No switch, by design: Student 1 AI suggestions, Student 3 AI transport
# suggestions and Student 5 AI budget analysis call AI-Mode directly. With no
# AI-Mode the host does not resolve, so each fails at connect time with a 503
# "AI-Mode ... unavailable" message in its panel; nothing waits on a timeout.

# Frontends: build page URLs (static files, forms, HTMX) as https://. Azure's
# ingress ends TLS and calls the container over plain HTTP, overwriting
# X-Forwarded-Proto with the browser's scheme. Uvicorn believes that header
# only from FORWARDED_ALLOW_IPS, by default loopback, and the ingress address is
# neither loopback nor fixed. The container port is reachable only through that
# ingress and from our own apps in the environment, so trust any peer. Do not
# copy this to a host where the port is open to anyone else.
# X-Forwarded-For is appended to, so request.client is spoofable; nothing uses it.
TRIPGENIE_FORWARDED_ALLOW_IPS=*
